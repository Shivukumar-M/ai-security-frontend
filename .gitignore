# ============================================================
# Frontend .gitignore — React / Vite
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── Build Output ─────────────────────────────────────────────
dist/
dist-ssr/
build/

# ── Environment & Secrets ────────────────────────────────────
.env
.env.production
.env.*
!.env.example
*.local

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing & Coverage ───────────────────────────────────────
coverage/
.nyc_output/

# ── Cache ────────────────────────────────────────────────────
.vite/
.cache/
.eslintcache

# ── Editor directories and files ────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Misc ─────────────────────────────────────────────────────
*.tmp
*.bak
